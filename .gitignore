# ============================================================================
# WHITELIST MODEL. Ignore everything; allow only what is deliberately public.
#
# Rationale: this repo is PUBLIC. A blacklist fails open — anything nobody
# thought to exclude gets published. A whitelist fails closed. Adding a file
# to the public surface must be a decision someone makes, not the default.
#
# Before adding an allow rule, ask: does this need to be public, or is it
# merely not embarrassing? Those are different tests.
# ============================================================================

# Ignore everything by default
*

# Directory traversal must stay open or nothing below matches
!*/

# --- The public surface ---------------------------------------------------

!.gitignore
!README.md
!LICENSE*

# The plugin itself — this is the artifact people install and read
!.claude-plugin/**
!agents/**
!commands/**
!skills/**
!playbooks/**
!templates/**

# Implementation and its tests
!scripts/**
!tests/**

# --- Never public, even if a rule above would otherwise match --------------

# Build noise
__pycache__/
*.pyc
.pytest_cache/

# Client and target data — hard rule 3. Engagements live in ~/engagements/.
*.secrets.env
.secrets.env
engagements/
evidence/
**/authorization/

# Internal research, strategy, legal exposure, and the wiki. These contain
# findings about our own controls, harness bypass techniques, commercial
# analysis and legal exposure. None of it needs to be public, and some of it
# is actively unhelpful to publish.
docs/
